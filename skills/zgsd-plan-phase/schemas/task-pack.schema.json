{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Impl Task Pack",
  "description": "Schema for impl task pack task-list.json",
  "type": "object",
  "required": ["feature_id", "feature_name", "tasks"],
  "properties": {
    "feature_id": { "type": "string", "pattern": "^[A-Z]+-LITE-\\d+$" },
    "feature_name": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "name", "priority", "dependencies", "acceptance_criteria", "source_docs"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-\\d{3}$" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "estimated_hours": { "type": "number", "minimum": 0 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^task-\\d{3}$" }
          },
          "dependency_type": { "type": "object" },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "source_docs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "exception": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
