{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zeval/EvalRequest.schema.json",
  "title": "EvalRequest",
  "description": "zeval-skill 的标准评估请求",
  "type": "object",
  "required": ["target", "rubric", "judges"],
  "additionalProperties": true,
  "properties": {
    "target": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["skill-design", "skill-impl", "agent-run", "code-diff", "document", "prompt-output", "conversation"]
        },
        "ref":  { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id":      { "type": "string" },
        "version": { "type": "string" },
        "overrides": { "type": "array", "items": { "type": "object" } }
      }
    },
    "judges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id":    { "type": "string" },
          "role":  { "enum": ["correctness", "safety", "style", "completeness", "efficiency", "contract", "clarity", "custom"] },
          "weight": { "type": "number", "default": 1.0 },
          "model_hint": { "type": "string" }
        }
      }
    },
    "adjudicator": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["weighted-mean", "majority-vote", "any-fail-blocks", "unanimous-pass"], "default": "weighted-mean" },
        "human_in_loop": { "type": "boolean", "default": false }
      }
    },
    "baseline": {
      "type": "object",
      "properties": {
        "mode":       { "enum": ["none", "compare", "enforce"], "default": "compare" },
        "baseline_id": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "properties": {
        "seed":     { "type": "string" },
        "snapshot_inputs": { "type": "boolean", "default": true }
      }
    }
  }
}
