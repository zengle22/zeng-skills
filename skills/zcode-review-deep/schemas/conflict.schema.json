{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zcode-review-deep/schemas/conflict.schema.json",
  "title": "ReviewConflict",
  "description": "Severity disagreement between agents on the same issue. .",
  "version": "1.0",
  "type": "object",
  "required": ["conflict_id", "issue_ids", "file", "line_range", "dimension", "severity_dispute", "status"],
  "properties": {
    "conflict_id": {
      "type": "string",
      "description": "Unique conflict ID: {batch_id}-conflict-{seq:03d}"
    },
    "issue_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of the disputed issues"
    },
    "file": { "type": "string" },
    "line_range": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "dimension": { "type": "string" },
    "severity_dispute": {
      "type": "object",
      "description": "Map of agent_id -> assigned severity",
      "additionalProperties": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "none"] }
    },
    "status": {
      "type": "string",
      "enum": ["auto_resolved", "discussing", "escalated", "human_decided"]
    },
    "resolution": {
      "type": "object",
      "properties": {
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "dropped"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of discussion rounds conducted"
    }
  },
  "additionalProperties": false
}
