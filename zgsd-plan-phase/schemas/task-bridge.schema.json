{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Bridge Manifest",
  "description": "Schema for 00-TASK-BRIDGE.json generated by zgsd-plan-phase",
  "type": "object",
  "required": ["schema_version", "phase", "phase_dir", "impl_dir", "feature_id", "source_hash", "generated_at", "dag", "requirements_coverage", "plans", "task_mapping", "validation", "path_normalization"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "phase": { "type": "string" },
    "phase_dir": { "type": "string" },
    "impl_dir": { "type": "string" },
    "feature_id": { "type": "string" },
    "source_hash": { "type": "string", "pattern": "^sha256:" },
    "generated_at": { "type": "string" },
    "dag": {
      "type": "object",
      "required": ["status", "topological_order"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "topological_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cycles": { "type": "array" },
        "isolated_nodes": { "type": "array" }
      }
    },
    "requirements_coverage": {
      "type": "object",
      "required": ["required", "covered", "missing"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "covered": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plan_id", "wave", "source_tasks", "requirements", "depends_on"],
        "properties": {
          "plan_id": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" },
          "wave": { "type": "integer", "minimum": 1 },
          "source_tasks": { "type": "array", "items": { "type": "string" } },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "files_modified": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "task_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["plan_id", "task_file", "status"],
        "properties": {
          "plan_id": { "type": "string" },
          "task_file": { "type": "string" },
          "status": { "type": "string", "enum": ["mapped", "unmapped", "error"] }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["all_tasks_mapped_once", "plan_dependencies_respect_task_dag", "same_wave_file_overlap"],
      "properties": {
        "all_tasks_mapped_once": { "type": "boolean" },
        "plan_dependencies_respect_task_dag": { "type": "boolean" },
        "same_wave_file_overlap": { "type": "boolean" }
      }
    },
    "path_normalization": {
      "type": "object",
      "required": ["app_dir", "normalized_paths"],
      "properties": {
        "app_dir": { "type": "string", "description": "App directory prefix used for normalization" },
        "normalized_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["original", "normalized"],
            "properties": {
              "original": { "type": "string", "description": "Original bare path from task markdown" },
              "normalized": { "type": "string", "description": "Normalized path with app dir prefix" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
