{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills/ll-code-review-deep/schemas/problem.schema.json",
  "title": "CodeReviewProblem",
  "description": "Single issue found by a review agent. Part of ADR-058 Deep Code Review Skill.",
  "version": "1.0",
  "type": "object",
  "required": ["issue_id", "severity", "dimension", "file", "line_range", "evidence", "description", "found_by"],
  "properties": {
    "issue_id": {
      "type": "string",
      "description": "Globally unique issue ID: {batch_id}-{agent_id}-{severity}-{seq:03d}"
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "P0=blocker, P1=high, P2=medium, P3=low"
    },
    "dimension": {
      "type": "string",
      "description": "Dimension ID, e.g. C01-Consistency, C03-Logic"
    },
    "file": {
      "type": "string",
      "description": "Relative file path where issue occurs"
    },
    "line_range": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 },
      "description": "[start_line] or [start_line, end_line]"
    },
    "evidence": {
      "type": "string",
      "description": "Exact code snippet (with line numbers) supporting the finding"
    },
    "description": {
      "type": "string",
      "description": "Human-readable explanation of the problem"
    },
    "found_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "List of agent IDs that reported this issue"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "default": "medium",
      "description": "Agent's confidence in this finding"
    },
    "rubric_ref": {
      "type": "string",
      "description": "Reference to specific rubric item, e.g. C03-1"
    }
  },
  "additionalProperties": false
}
