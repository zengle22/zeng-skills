{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodePatrolOutputEnvelope",
  "description": "Output envelope schema for zeng-code-patrol skill",
  "type": "object",
  "required": ["patrol_id", "output_dir", "artifacts"],
  "properties": {
    "patrol_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[a-zA-Z0-9]{12}$",
      "description": "Unique patrol identifier"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Root output directory for this patrol"
    },
    "artifacts": {
      "type": "object",
      "required": ["report_json", "report_md", "manifest", "patrol_state"],
      "properties": {
        "report_json": { "type": "string", "description": "Path to report.json" },
        "report_md": { "type": "string", "description": "Path to report.md" },
        "manifest": { "type": "string", "description": "Path to manifest.json" },
        "patrol_state": { "type": "string", "description": "Path to patrol-state.json" },
        "hotspots": { "type": ["string", "null"], "description": "Path to hotspots.json" },
        "baseline_diff": { "type": ["string", "null"], "description": "Path to baseline-diff.json" },
        "suggested_fixes": { "type": ["string", "null"], "description": "Path to suggested-fixes.json" },
        "raw_l1": { "type": "string", "description": "Path to raw/L1-results.json" },
        "raw_l3": { "type": "string", "description": "Path to raw/L3-results.json" }
      }
    }
  }
}
