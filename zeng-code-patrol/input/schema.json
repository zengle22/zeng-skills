{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodePatrolInput",
  "description": "Input request schema for zeng-code-patrol skill",
  "type": "object",
  "required": ["paths"],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Directory or file paths to scan"
    },
    "scope": {
      "type": "string",
      "enum": ["full", "delta", "staged", "targeted"],
      "default": "full",
      "description": "Scan scope mode"
    },
    "format": {
      "type": "string",
      "enum": ["markdown", "json"],
      "default": "markdown",
      "description": "Output report format"
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 500,
      "description": "Maximum files to scan"
    },
    "max_file_size": {
      "type": "integer",
      "minimum": 1,
      "default": 1048576,
      "description": "Single file size limit in bytes"
    },
    "since_days": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Days back for delta scope"
    },
    "output_dir": {
      "type": "string",
      "default": ".zeng-code-patrol",
      "description": "Output directory for patrol artifacts"
    },
    "baseline": {
      "type": ["string", "null"],
      "description": "Path to previous patrol report for comparison"
    },
    "ruleset": {
      "type": ["string", "null"],
      "description": "Path to custom ruleset YAML"
    },
    "min_severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "default": "P3",
      "description": "Minimum severity to report"
    },
    "fix_mode": {
      "type": "string",
      "enum": ["report-only", "suggest-fixes"],
      "default": "report-only",
      "description": "Fix suggestion mode"
    },
    "non_interactive": {
      "type": "boolean",
      "default": false,
      "description": "Disable interactive prompts"
    },
    "resume": {
      "type": ["string", "null"],
      "description": "Patrol ID to resume"
    },
    "fail_on_p0p1": {
      "type": "boolean",
      "default": false,
      "description": "Return exit code 1 when P0/P1 found"
    }
  }
}
